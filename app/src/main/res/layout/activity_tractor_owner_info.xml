<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#FFEFEF"
    tools:context=".TractorOwnerInfo">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_margin="30dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:orientation="vertical">


            <!-- Full Name Input -->
            <EditText
                android:id="@+id/editTextFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:padding="10dp"/>

            <!-- Phone Number Input -->
            <EditText
                android:id="@+id/editTextPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:layout_marginTop="10dp"
                android:inputType="phone"
                android:padding="10dp"/>

            <!-- Tractor Name Input -->
            <EditText
                android:id="@+id/editTextTractorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tractor Name"
                android:layout_marginTop="10dp"
                android:inputType="text"
                android:padding="10dp"/>

            <!-- Tractor Number Input -->
            <EditText
                android:id="@+id/editTextTractorNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Tractor Number MH50BS1338"
                android:inputType="text"
                android:padding="10dp"/>

            <!-- First Troylee Number Input -->
            <EditText
                android:id="@+id/editTextFirstTroyleeNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="First Troylee Number"
                android:inputType="number"
                android:padding="10dp"/>

            <!-- Second Troylee Number Input -->
            <EditText
                android:id="@+id/editTextSecondTroyleeNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Second Troylee Number"
                android:inputType="number"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/editTextPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Enter Password"
                android:inputType="number"
                android:padding="10dp"/>

            <!-- Submit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Submit"
                android:padding="10dp"/>



        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
