<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:gravity="center"
    android:layout_margin="15dp"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/editTextTractor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Tractor Number"
        android:inputType="text" />

    <Button
        android:id="@+id/buttonAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Tractor" />

    <TextView
        android:id="@+id/textViewLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Line: " />

    <EditText
        android:id="@+id/searchNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:hint="Enter Tractor Number to search"
        android:inputType="text" />

    <Button
        android:id="@+id/buttonSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Search Tractor" />

    <TextView
        android:id="@+id/textViewQueueNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Queue Number: "
        android:visibility="gone" />




</LinearLayout>

